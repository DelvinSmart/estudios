        '11:CLASE-GUIADA.md:12',
        '11:CLASE-GUIADA.md:13',
        '11:CLASE-GUIADA.md:14',
        '11:CLASE-GUIADA.md:15',
        '11:CLASE-GUIADA.md:16',
        '12:CLASE-GUIADA.md:1',
        '12:CLASE-GUIADA.md:2',
        '12:CLASE-GUIADA.md:3',
        '12:CLASE-GUIADA.md:4',
        '12:CLASE-GUIADA.md:5',
        '12:CLASE-GUIADA.md:6',
        '12:CLASE-GUIADA.md:7',
        '12:CLASE-GUIADA.md:8',
        '12:CLASE-GUIADA.md:9',
        '12:CLASE-GUIADA.md:10',
        '12:CLASE-GUIADA.md:11',
        '12:CLASE-GUIADA.md:12',
        '12:CLASE-GUIADA.md:13',
        '13:CLASE-GUIADA.md:1',
        '13:CLASE-GUIADA.md:2',
        '13:CLASE-GUIADA.md:3',
        '13:CLASE-GUIADA.md:4',
        '13:CLASE-GUIADA.md:5',
        '13:CLASE-GUIADA.md:6',
        '13:CLASE-GUIADA.md:7',
        '13:CLASE-GUIADA.md:8',
        '13:CLASE-GUIADA.md:9',
        '13:CLASE-GUIADA.md:10',
        '13:CLASE-GUIADA.md:11',
        '13:CLASE-GUIADA.md:12',
        '13:CLASE-GUIADA.md:13',
        '13:CLASE-GUIADA.md:14',
        '14:CLASE-GUIADA.md:1',
        '14:CLASE-GUIADA.md:2',
        '14:CLASE-GUIADA.md:3',
        '14:CLASE-GUIADA.md:4',
        '14:CLASE-GUIADA.md:5',
        '14:CLASE-GUIADA.md:6',
        '14:CLASE-GUIADA.md:7',
        '14:CLASE-GUIADA.md:8',
        '14:CLASE-GUIADA.md:9',
        '14:CLASE-GUIADA.md:10',
        '14:CLASE-GUIADA.md:11',
        '14:CLASE-GUIADA.md:12',
        '14:CLASE-GUIADA.md:13',
        '14:CLASE-GUIADA.md:14',
        '18:CLASE-GUIADA.md:1',
        '18:CLASE-GUIADA.md:2',
        '18:CLASE-GUIADA.md:3',
        '18:CLASE-GUIADA.md:4',
        '18:CLASE-GUIADA.md:5',
        '18:CLASE-GUIADA.md:6',
        '18:CLASE-GUIADA.md:7',
        '18:CLASE-GUIADA.md:8',
        '18:CLASE-GUIADA.md:9',
        '18:CLASE-GUIADA.md:10',
        '18:CLASE-GUIADA.md:11',
        '18:CLASE-GUIADA.md:12',
        '20:CLASE-GUIADA.md:1',
        '20:CLASE-GUIADA.md:2',
        '20:CLASE-GUIADA.md:3',
        '20:CLASE-GUIADA.md:4',
        '20:CLASE-GUIADA.md:5',
        '20:CLASE-GUIADA.md:6',
        '20:CLASE-GUIADA.md:7',
        '20:CLASE-GUIADA.md:8',
        '20:CLASE-GUIADA.md:9',
        '20:CLASE-GUIADA.md:10',
        '20:CLASE-GUIADA.md:11',
        '20:CLASE-GUIADA.md:12',
        '20:CLASE-GUIADA.md:13',
        '20:CLASE-GUIADA.md:14',
        '19:LECCION.md:1',
        '19:LECCION.md:2',
        '19:LECCION.md:3',
        '19:LECCION.md:4',
        '19:LECCION.md:5',
        '19:LECCION.md:6',
        '19:LECCION.md:7',
        '19:LECCION.md:8',
        '19:LECCION.md:9',
        '19:LECCION.md:10',
        '19:LECCION.md:11'
      ];
    }
    function total() { return 229; }
    function espera() { return duration.value(60, 's'); }
    function logueado() { return request.auth != null; }

    // ---------- progreso/{uid}: los bombillos de cada persona ----------
    match /progreso/{uid} {
      allow read: if logueado() && request.auth.uid == uid;

      // El primer bombillo
      allow create: if logueado() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['n', 'inicio', 'ultimo', 'ultimaParte', 'partes'])
        && request.resource.data.n == 1
        && request.resource.data.ultimaParte in partes()
        && request.resource.data.partes.keys().hasOnly([request.resource.data.ultimaParte])
        && request.resource.data.partes[request.resource.data.ultimaParte] == request.time
        && request.resource.data.inicio == request.time
        && request.resource.data.ultimo == request.time;

      // Cada bombillo siguiente: uno solo, nuevo, de la lista, y no antes de la espera
      allow update: if logueado() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['n', 'inicio', 'ultimo', 'ultimaParte', 'partes'])
        && request.resource.data.n == resource.data.n + 1
        && request.resource.data.n <= total()
        && request.resource.data.inicio == resource.data.inicio
        && request.time > resource.data.ultimo + espera()
        && request.resource.data.ultimo == request.time
        && request.resource.data.ultimaParte in partes()
        && request.resource.data.partes.diff(resource.data.partes).addedKeys() == [request.resource.data.ultimaParte].toSet()
        && request.resource.data.partes.diff(resource.data.partes).affectedKeys() == [request.resource.data.ultimaParte].toSet()
        && request.resource.data.partes[request.resource.data.ultimaParte] == request.time;

      allow delete: if false;
    }

    // ---------- certificados/{codigo}: públicos para verificar, uno por persona ----------
    match /certificados/{codigo} {
      // Cualquiera puede comprobar UN código; nadie puede listar todos.
      allow get: if true;
      allow list: if false;

      allow create: if logueado()
        && codigo.matches('^ME-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{4}$')
        && request.resource.data.keys().hasOnly(['uid', 'nombre', 'emitido', 'inicio', 'fin', 'partes'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() >= 3 && request.resource.data.nombre.size() <= 80
        && request.resource.data.emitido == request.time
        && request.resource.data.partes == total()
        && get(/databases/$(database)/documents/progreso/$(request.auth.uid)).data.n == total()
        && request.resource.data.inicio == get(/databases/$(database)/documents/progreso/$(request.auth.uid)).data.inicio
        && request.resource.data.fin == get(/databases/$(database)/documents/progreso/$(request.auth.uid)).data.ultimo
        && getAfter(/databases/$(database)/documents/emitidos/$(request.auth.uid)).data.codigo == codigo;

      // Se puede borrar el propio (por ejemplo, para corregir el nombre y emitirlo de nuevo).
      allow delete: if logueado() && resource.data.uid == request.auth.uid
        && !existsAfter(/databases/$(database)/documents/emitidos/$(request.auth.uid));
      allow update: if false;
    }

    // ---------- emitidos/{uid}: qué código tiene cada persona (máximo uno) ----------
    match /emitidos/{uid} {
      allow read: if logueado() && request.auth.uid == uid;
      allow create: if logueado() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['codigo'])
        && getAfter(/databases/$(database)/documents/certificados/$(request.resource.data.codigo)).data.uid == uid;
      allow delete: if logueado() && request.auth.uid == uid
        && !existsAfter(/databases/$(database)/documents/certificados/$(resource.data.codigo));
      allow update: if false;
    }
  }
}
