        '04:CLASE-GUIADA.md:3',
        '04:CLASE-GUIADA.md:4',
        '04:CLASE-GUIADA.md:5',
        '04:CLASE-GUIADA.md:6',
        '04:CLASE-GUIADA.md:7',
        '04:CLASE-GUIADA.md:8',
        '04:CLASE-GUIADA.md:9',
        '04:CLASE-GUIADA.md:10',
        '04:CLASE-GUIADA.md:11',
        '05:CLASE-GUIADA.md:1',
        '05:CLASE-GUIADA.md:2',
        '05:CLASE-GUIADA.md:3',
        '05:CLASE-GUIADA.md:4',
        '05:CLASE-GUIADA.md:5',
        '05:CLASE-GUIADA.md:6',
        '05:CLASE-GUIADA.md:7',
        '05:CLASE-GUIADA.md:8',
        '05:CLASE-GUIADA.md:9',
        '06:CLASE-GUIADA.md:1',
        '06:CLASE-GUIADA.md:2',
        '06:CLASE-GUIADA.md:3',
        '06:CLASE-GUIADA.md:4',
        '06:CLASE-GUIADA.md:5',
        '06:CLASE-GUIADA.md:6',
        '06:CLASE-GUIADA.md:7',
        '06:CLASE-GUIADA.md:8',
        '06:CLASE-GUIADA.md:9',
        '06:CLASE-GUIADA.md:10',
        '06:CLASE-GUIADA.md:11',
        '06:CLASE-GUIADA.md:12',
        '07:CLASE-GUIADA.md:1',
        '07:CLASE-GUIADA.md:2',
        '07:CLASE-GUIADA.md:3',
        '07:CLASE-GUIADA.md:4',
        '07:CLASE-GUIADA.md:5',
        '07:CLASE-GUIADA.md:6',
