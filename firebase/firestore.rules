        '15:CLASE-GUIADA.md:4',
        '15:CLASE-GUIADA.md:5',
        '15:CLASE-GUIADA.md:6',
        '15:CLASE-GUIADA.md:7',
        '15:CLASE-GUIADA.md:8',
        '15:CLASE-GUIADA.md:9',
        '15:CLASE-GUIADA.md:10',
        '16:CLASE-GUIADA.md:1',
        '16:CLASE-GUIADA.md:2',
        '16:CLASE-GUIADA.md:3',
        '16:CLASE-GUIADA.md:4',
        '16:CLASE-GUIADA.md:5',
        '16:CLASE-GUIADA.md:6',
        '16:CLASE-GUIADA.md:7',
        '16:CLASE-GUIADA.md:8',
        '16:CLASE-GUIADA.md:9',
        '16:CLASE-GUIADA.md:10',
        '16:CLASE-GUIADA.md:11',
        '16:CLASE-GUIADA.md:12',
        '17:CLASE-GUIADA.md:1',
        '17:CLASE-GUIADA.md:2',
        '17:CLASE-GUIADA.md:3',
        '17:CLASE-GUIADA.md:4',
        '17:CLASE-GUIADA.md:5',
        '17:CLASE-GUIADA.md:6',
        '17:CLASE-GUIADA.md:7',
        '17:CLASE-GUIADA.md:8',
        '17:CLASE-GUIADA.md:9',
        '17:CLASE-GUIADA.md:10',
        '17:CLASE-GUIADA.md:11',
        '17:CLASE-GUIADA.md:12',
        '08:CLASE-GUIADA.md:1',
        '08:CLASE-GUIADA.md:2',
        '08:CLASE-GUIADA.md:3',
        '08:CLASE-GUIADA.md:4',
        '08:CLASE-GUIADA.md:5',
        '08:CLASE-GUIADA.md:6',
        '08:CLASE-GUIADA.md:7',
        '08:CLASE-GUIADA.md:8',
        '08:CLASE-GUIADA.md:9',
        '09:CLASE-GUIADA.md:1',
        '09:CLASE-GUIADA.md:2',
        '09:CLASE-GUIADA.md:3',
        '09:CLASE-GUIADA.md:4',
        '09:CLASE-GUIADA.md:5',
        '09:CLASE-GUIADA.md:6',
        '09:CLASE-GUIADA.md:7',
        '09:CLASE-GUIADA.md:8',
        '09:CLASE-GUIADA.md:9',
        '09:CLASE-GUIADA.md:10',
        '09:CLASE-GUIADA.md:11',
        '10:CLASE-GUIADA.md:1',
        '10:CLASE-GUIADA.md:2',
        '10:CLASE-GUIADA.md:3',
        '10:CLASE-GUIADA.md:4',
        '10:CLASE-GUIADA.md:5',
        '10:CLASE-GUIADA.md:6',
        '10:CLASE-GUIADA.md:7',
        '10:CLASE-GUIADA.md:8',
        '10:CLASE-GUIADA.md:9',
        '10:CLASE-GUIADA.md:10',
        '10:CLASE-GUIADA.md:11',
        '11:CLASE-GUIADA.md:1',
        '11:CLASE-GUIADA.md:2',
        '11:CLASE-GUIADA.md:3',
        '11:CLASE-GUIADA.md:4',
        '11:CLASE-GUIADA.md:5',
        '11:CLASE-GUIADA.md:6',
        '11:CLASE-GUIADA.md:7',
        '11:CLASE-GUIADA.md:8',
        '11:CLASE-GUIADA.md:9',
        '11:CLASE-GUIADA.md:10',
