        '40:LECCION.md:4',
        '40:LECCION.md:5',
        '41:LECCION.md:1',
        '41:LECCION.md:2',
        '41:LECCION.md:3',
        '41:LECCION.md:4',
        '41:LECCION.md:5',
        '42:LECCION.md:1',
        '42:LECCION.md:2',
        '42:LECCION.md:3',
        '42:LECCION.md:4',
        '43:LECCION.md:1',
        '43:LECCION.md:2',
        '43:LECCION.md:3',
        '43:LECCION.md:4',
        '43:LECCION.md:5'
      ] : (curso == 'seguridad' ? [
        '22:LECCION.md:1',
        '22:LECCION.md:2',
        '22:LECCION.md:3',
        '22:LECCION.md:4',
        '22:LECCION.md:5',
        '22:LECCION.md:6',
        '22:LECCION.md:7',
        '22:LECCION.md:8',
        '23:LECCION.md:1',
        '23:LECCION.md:2',
        '23:LECCION.md:3',
        '23:LECCION.md:4',
        '23:LECCION.md:5',
        '23:LECCION.md:6',
        '23:LECCION.md:7',
        '23:LECCION.md:8',
        '23:LECCION.md:9',
        '24:LECCION.md:1',
        '24:LECCION.md:2',
        '24:LECCION.md:3',
        '24:LECCION.md:4',
