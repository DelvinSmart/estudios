rules_version = '2';

// Reglas de seguridad del Mapa de estudios (proyecto mapa-estudios-ds).
// ESTE ARCHIVO SE GENERA: edita reglas.plantilla y corre `node firebase/generar-reglas.mjs`.
//
// La idea: el navegador NO decide nada. Firestore solo acepta:
//   - cuentas con correo de Gmail VERIFICADO;
//   - prender UN bombillo a la vez, EN ORDEN (la parte anterior del curso ya prendida),
//     de la lista oficial de ese curso, con la hora del servidor,
//     y al menos __ESPERA__ segundos después del anterior;
//   - en las partes con práctica, solo si el servidor ya la aprobó (respuestas privadas);
//   - nunca borrar, cambiar ni adelantar fechas;
//   - emitir el certificado solo si el servidor ya ve TODAS las partes de ese curso.
service cloud.firestore {
  match /databases/{database}/documents {

    __FUNCIONES_CURSOS__
    // La parte que va justo antes de "p" en su curso ('' si p es la primera del curso).
    function anteriorDe(curso, p) {
      let t = p.split(':');
      return int(t[2]) > 1 ? t[0] + ':' + t[1] + ':' + string(int(t[2]) - 1)
        : (p in inicioDeClase(curso) ? inicioDeClase(curso)[p] : '');
    }
    function espera() { return duration.value(__ESPERA__, 's'); }

    // Sesión abierta, correo verificado y de Gmail.
    function verificado() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower().matches('^[^@]+@gmail[.]com$');
    }
    // Las partes con práctica solo se prenden si el SERVIDOR aprobó su práctica
    // (la función corregirPractica escribe en cursos/{curso}/aprobadas/{uid}; el navegador no puede).
    function aprobadaPorElServidor(curso, uid, parte) {
      return !(parte in conPractica(curso))
        || (exists(/databases/$(database)/documents/cursos/$(curso)/aprobadas/$(uid))
            && parte in get(/databases/$(database)/documents/cursos/$(curso)/aprobadas/$(uid)).data.partes);
    }
    function progresoDe(curso, uid) {
      return get(/databases/$(database)/documents/cursos/$(curso)/progreso/$(uid)).data;
    }

    // ---------- cursos/{curso}/progreso/{uid}: los bombillos de cada persona ----------
    match /cursos/{curso}/progreso/{uid} {
      allow read: if verificado() && request.auth.uid == uid;

      // El primer bombillo
      allow create: if verificado() && request.auth.uid == uid
        && curso in cursos()
        && request.resource.data.keys().hasOnly(['n', 'inicio', 'ultimo', 'ultimaParte', 'partes'])
        && request.resource.data.n == 1
        && request.resource.data.ultimaParte in partes(curso)
        && request.resource.data.partes.keys().hasOnly([request.resource.data.ultimaParte])
        && request.resource.data.partes[request.resource.data.ultimaParte] == request.time
        && request.resource.data.inicio == request.time
        && request.resource.data.ultimo == request.time
        // En orden: el primer bombillo de un curso es su primera parte.
        && request.resource.data.ultimaParte == primera(curso)
        && aprobadaPorElServidor(curso, uid, request.resource.data.ultimaParte);

      // Cada bombillo siguiente: uno solo, nuevo, de la lista, y no antes de la espera
      allow update: if verificado() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['n', 'inicio', 'ultimo', 'ultimaParte', 'partes'])
        && request.resource.data.n == resource.data.n + 1
        && request.resource.data.n <= total(curso)
        && request.resource.data.inicio == resource.data.inicio
        && request.time > resource.data.ultimo + espera()
        && request.resource.data.ultimo == request.time
        && request.resource.data.ultimaParte in partes(curso)
        && request.resource.data.partes.diff(resource.data.partes).addedKeys() == [request.resource.data.ultimaParte].toSet()
        && request.resource.data.partes.diff(resource.data.partes).affectedKeys() == [request.resource.data.ultimaParte].toSet()
        && request.resource.data.partes[request.resource.data.ultimaParte] == request.time
        // En orden: la parte anterior del curso ya tiene que estar prendida.
        && (request.resource.data.ultimaParte == primera(curso)
            || anteriorDe(curso, request.resource.data.ultimaParte) in resource.data.partes)
        && aprobadaPorElServidor(curso, uid, request.resource.data.ultimaParte);

      allow delete: if false;
    }

    // ---------- cursos/{curso}/aprobadas/{uid}: las prácticas que aprobó el servidor ----------
    // Solo la escribe la función corregirPractica (que corrige con las respuestas privadas).
    match /cursos/{curso}/aprobadas/{uid} {
      allow read: if verificado() && request.auth.uid == uid;
      allow write: if false;
    }

    // ---------- cursos/{curso}/emitidos/{uid}: qué código tiene cada persona en ese curso (máximo uno) ----------
    match /cursos/{curso}/emitidos/{uid} {
      allow read: if verificado() && request.auth.uid == uid;
      allow create: if verificado() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['codigo'])
        && getAfter(/databases/$(database)/documents/certificados/$(request.resource.data.codigo)).data.uid == uid
        && getAfter(/databases/$(database)/documents/certificados/$(request.resource.data.codigo)).data.curso == curso;
      allow delete: if verificado() && request.auth.uid == uid
        && !existsAfter(/databases/$(database)/documents/certificados/$(resource.data.codigo));
      allow update: if false;
    }

    // ---------- certificados/{codigo}: públicos para verificar ----------
    match /certificados/{codigo} {
      // Cualquiera puede comprobar UN código; nadie puede listar todos.
      allow get: if true;
      allow list: if false;

      allow create: if verificado()
        && request.resource.data.keys().hasOnly(['uid', 'curso', 'nombre', 'emitido', 'inicio', 'fin', 'partes'])
        && request.resource.data.curso in cursos()
        && codigo.matches('^' + prefijo(request.resource.data.curso) + '-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{4}$')
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() >= 5 && request.resource.data.nombre.size() <= 80
        // Solo letras, espacios, punto, apóstrofo y guion: nada de enlaces, emojis ni símbolos raros.
        && request.resource.data.nombre.matches("^[\\p{L}\\p{M}][\\p{L}\\p{M} .'-]*$")
        && request.resource.data.emitido == request.time
        && request.resource.data.partes == total(request.resource.data.curso)
        && progresoDe(request.resource.data.curso, request.auth.uid).n == total(request.resource.data.curso)
        && request.resource.data.inicio == progresoDe(request.resource.data.curso, request.auth.uid).inicio
        && request.resource.data.fin == progresoDe(request.resource.data.curso, request.auth.uid).ultimo
        && getAfter(/databases/$(database)/documents/cursos/$(request.resource.data.curso)/emitidos/$(request.auth.uid)).data.codigo == codigo;

      // Se puede borrar el propio (por ejemplo, para corregir el nombre y emitirlo de nuevo).
      allow delete: if verificado() && resource.data.uid == request.auth.uid
        && !existsAfter(/databases/$(database)/documents/cursos/$(resource.data.curso)/emitidos/$(request.auth.uid));
      allow update: if false;
    }
  }
}
